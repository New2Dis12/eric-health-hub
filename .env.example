# All variables are SERVER ONLY. Configure securely; never commit populated files.
# Existing AUTH0_DOMAIN, AUTH0_ALLOWED_SUB, Garmin, Oura and Upstash values stay intact.
AUTH0_DOMAIN=
AUTH0_ALLOWED_SUB=

# Existing tenant's suitable Regular Web Application client (not a new tenant).
# Do not repurpose or modify the ChatGPT MCP client/audience to make web login work.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=https://eric-health-hub.vercel.app

# Restricted runtime role; use a pooled PostgreSQL URL in serverless hosting.
DATABASE_URL=
# Direct migration-owner URL for operator CLI only; do NOT add to Vercel runtime.
DATABASE_MIGRATION_URL=

# Only enable after auth/database verification. Default is off.
STUNNA_ENABLED=false
