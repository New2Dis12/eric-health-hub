  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && pnpm test:ui",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts up",
    "db:rollback": "node --conditions=react-server --import tsx scripts/migrate.ts down",
    "test:ui": "TSX_TSCONFIG_PATH=tests/tsconfig.ui.json node --import tsx --import ./tests/ui-hooks.mjs --test tests/player-ui.test.tsx tests/source-evidence-ui.test.tsx"
  },
  "dependencies": {
