    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
